# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_MARKET_DATA=market-data
KAFKA_TOPIC_NEWS_DATA=news-data
KAFKA_TOPIC_SENTIMENT_DATA=sentiment-data
KAFKA_TOPIC_PREDICTION_DATA=prediction-data
KAFKA_ENABLED=false

# Market Simulator
MARKET_UPDATE_INTERVAL_MS=100
MARKET_SYMBOLS=DEMO
MARKET_INITIAL_PRICE=500.25

# News Simulator
NEWS_UPDATE_INTERVAL_SECONDS=5
NEWS_UPDATE_INTERVAL_MS=5000
NEWS_SYMBOLS=DEMO

# Model Configuration
MODEL_MODE=mock
MODEL_FALLBACK=false
PREDICTION_INTERVAL_SECONDS=1
# Supported: mock, tft
# mock: Use rule-based predictions for development/demo
# tft: Use trained Temporal Fusion Transformer model

# Model paths
TFT_MODEL_PATH=models/tft_model.pt
TFT_SCALER_PATH=models/scaler.pkl

# Logging
LOG_LEVEL=info
# Supported: debug, info, warning, error, critical

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# Frontend
VITE_API_URL=http://localhost:8000
FRONTEND_ORIGINS=http://localhost:5173

# HuggingFace
TRANSFORMERS_CACHE=./models/transformers_cache
HF_HOME=./models

# Device Configuration
DEVICE=cuda
# Supported: cuda, cpu
# System will automatically fall back to cpu if CUDA is unavailable
SENTIMENT_MODE=finbert
